#!/bin/sh

set -e

# Same safe.directory exemption as git_checkout — `git remote get-url`
# below triggers the dubious-ownership check. See git_checkout for the
# rationale.
export GIT_CONFIG_GLOBAL="${GIT_CONFIG_GLOBAL:-/tmp/codegen-gitconfig}"
printf '[safe]\n\tdirectory = *\n' > "${GIT_CONFIG_GLOBAL}"

cd "${WORKDIR}"
source .env

# APISERVER="https://${KUBERNETES_SERVICE_HOST}:${KUBERNETES_SERVICE_PORT}"
# TOKEN=$(cat /var/run/secrets/kubernetes.io/serviceaccount/token)
# CACERT="/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"

# Remove any authority from the REPOSITORY URL
REPOSITORY=$(git remote get-url --push origin)
REPOSITORY=$(durl +%S%H%p ${REPOSITORY})

# Emit the gen-branch HEAD SHA (captured by git_push) as the revision, not
# the branch name. host-manager pins the kpack Image to this SHA so kpack's
# SourceResolver stops polling the branch HEAD and only rebuilds on
# intentional re-pins. Fall back to BRANCH_NAME for older host-manager
# versions that don't yet honor status.source.revision over spec — they'll
# behave the same as before (branch-tracking). See
# kdex-tech/host-manager#38.
REVISION="${HEAD_SHA:-${BRANCH_NAME}}"

cat <<EOF > /dev/termination-log
{
	"repository": "${REPOSITORY}",
	"revision": "${REVISION}",
	"path": "${TARGET_DIR}"
}
EOF

cat /dev/termination-log

# RESPONSE=$(\
# 	curl ${APISERVER}/apis/kdex.dev/v1alpha1/namespaces/${FUNCTION_NAMESPACE}/kdexfunctions/${FUNCTION_NAME}/status \
# 		-s -w "%{http_code}" \
# 		--cacert "${CACERT}" \
# 		-X PATCH \
# 		-H "Content-Type: application/merge-patch+json" \
# 		-H "Authorization: Bearer ${TOKEN}" \
# 		--data "${DATA}")

# HTTP_CODE="${RESPONSE:${#RESPONSE}-3}"
# CONTENT="${RESPONSE:0:${#RESPONSE}-3}"

# echo "Status Code: ${HTTP_CODE}"
# echo "Response Body: ${CONTENT}"

# if [ "${HTTP_CODE}" -eq 200 ]; then
# 	echo "Success!"
# else
# 	echo "Status update failed with error."
# 	exit 1
# fi
