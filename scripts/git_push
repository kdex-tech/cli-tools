#!/bin/sh

set -e

# Same safe.directory exemption as git_checkout — each init container has
# its own /tmp so we must set it again here. See git_checkout for the
# rationale.
export GIT_CONFIG_GLOBAL="${GIT_CONFIG_GLOBAL:-/tmp/codegen-gitconfig}"
printf '[safe]\n\tdirectory = *\n' > "${GIT_CONFIG_GLOBAL}"

cd "${WORKDIR}"
source .env

cd "${TARGET_DIR}"
echo "${FUNCTION_SPEC}" > function.yaml
cd -

# 1. Commit (if there are changes) and push.
# Push uses --force-with-lease because git_checkout (v0.3.16+) rebases the
# gen branch onto SOURCE_REVISION, which rewrites history and makes a
# plain fast-forward push impossible. force-with-lease is safe: it
# refuses to push if the remote tip changed since our last fetch, so a
# concurrent operator-authored commit can't be clobbered silently.
# The push runs unconditionally — even when there are no working-tree
# changes from this codegen iteration, the LOCAL branch has been
# rebased and the REMOTE branch needs to catch up, or the next run will
# again find a divergent remote and fail the same way.
git add "${TARGET_DIR}"
if git diff-index --quiet HEAD; then
  echo "No working-tree changes detected for this iteration."
else
  git commit -m "Update function: ${FUNCTION_HOST}/${FUNCTION_NAME}:${FUNCTION_GENERATION}"
fi
git push --force-with-lease origin "${BRANCH_NAME}"

# 2. Capture the current HEAD SHA of the gen branch so patch_source_status
# can report it to host-manager. host-manager pins the kpack Image to this
# SHA, which stops kpack's SourceResolver from polling the branch HEAD and
# rebuilding on every unrelated push (monorepo "noisy neighbor"). Written
# unconditionally — even when no commit was made this iteration the SHA is
# still the gen branch tip, which is what we want to pin to. See
# kdex-tech/host-manager#38.
HEAD_SHA=$(git rev-parse HEAD)
echo "HEAD_SHA=${HEAD_SHA}" >> .env
