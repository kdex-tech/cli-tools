#!/bin/sh

set -e

# host-manager mounts WORKDIR as an EmptyDir owned by root:root when the
# pod spec omits fsGroup. The clone runs as a non-root user and produces
# .git/ owned by that user, but git's safe.directory check (CVE-2022-24765
# mitigation, default in git 2.35.2+) refuses to operate on a repo whose
# work-tree root is owned by a different UID than the current user. Every
# command after the clone then fails with the misleading "fatal: not in a
# git directory". The mount is ephemeral and pod-private, so a wildcard
# exception is safe. Same stanza in git_push and patch_source_status so
# the later init containers (which inherit nothing from this one's HOME)
# read the same config. See https://github.com/kdex-tech/cli-tools/issues/1.
export GIT_CONFIG_GLOBAL="${GIT_CONFIG_GLOBAL:-/tmp/codegen-gitconfig}"
printf '[safe]\n\tdirectory = *\n' > "${GIT_CONFIG_GLOBAL}"

cd "${WORKDIR}"

# 1. Clone the repo
REPOSITORY=$(durl +%S${GIT_USERNAME}:${GIT_PASSWORD}@%H%p ${GIT_HOST})
git clone "${REPOSITORY}/${GIT_ORG}/${GIT_REPO}" .

# 2. Basic Git Identity (No Signing)
git config user.email "${COMMITTER_EMAIL}"
git config user.name "${COMMITTER_NAME}"
# Explicitly disable signing to avoid errors if the runner has global defaults
git config commit.gpgsign false

# 3. Sanitize variables to create a safe branch name
BRANCH_NAME="gen/${FUNCTION_HOST}/${FUNCTION_NAME}"

# 4. Check if branch exists on remote, then switch or create
SOURCE_REVISION="${SOURCE_REVISION:-main}"
if git ls-remote --heads origin "${BRANCH_NAME}" | grep -q "${BRANCH_NAME}"; then
  git fetch origin "${BRANCH_NAME}"
  git checkout "${BRANCH_NAME}"

  # 4b. Rebase the existing gen branch onto SOURCE_REVISION so MR diffs
  # stay scoped to what the bot actually authored. Without this the gen
  # branch lags behind the source revision and the eventual review MR
  # shows a wall of unrelated work as deletions in the diff. See the
  # gen-branch lifecycle design spec at
  # docs/superpowers/specs/2026-05-26-gen-branch-lifecycle.md (in the
  # consumer repo or multi-modal-store).
  #
  # Aborts on conflict (exit 2 distinguishes from other errors). The
  # most likely cause is a hand-edit of a fngogen-generated file on the
  # source revision (api/*.gen.go, cmd/main.go), which we can't
  # auto-resolve. Operator recovery options are printed below.
  git fetch origin "${SOURCE_REVISION}"
  if ! git rebase "origin/${SOURCE_REVISION}"; then
    echo "FATAL: rebase ${BRANCH_NAME} onto origin/${SOURCE_REVISION} produced conflicts." >&2
    echo "Most likely cause: a fngogen-generated file was hand-edited on ${SOURCE_REVISION}." >&2
    echo "Recovery options:" >&2
    echo "  1. Revert the hand-edit on ${SOURCE_REVISION} and let the bot retry on next reconcile." >&2
    echo "  2. Rebase the gen branch manually + push, then trigger another regen." >&2
    echo "  3. Delete the gen branch (git push origin :${BRANCH_NAME}) AND bump a DEPLOY_NONCE on" >&2
    echo "     the KDexFunction to spawn a first-regen fresh branch from current ${SOURCE_REVISION}." >&2
    git rebase --abort
    exit 2
  fi
else
  git checkout -b "${BRANCH_NAME}"
fi

# 5. Create the subdirectory if it doesn't exist.
# When SOURCE_PATH is set (forwarded by host-manager v0.2.74+ when the
# function CR has spec.origin.source.path populated), write into that
# path so codegen output lands in the developer's chosen layout.
# Strip a leading "./" so SOURCE_PATH="./functions/foo" maps to
# "functions/foo" relative to the repo root.
# Falls back to the canonical convention for pure codegen mode (where
# spec.origin.source is unset and the function repo has no
# pre-existing layout).
if [ -n "${SOURCE_PATH:-}" ]; then
  TARGET_DIR="${SOURCE_PATH#./}"
else
  TARGET_DIR="${COMMIT_SUB_DIRECTORY}/${FUNCTION_HOST}/${FUNCTION_NAME}"
fi
mkdir -p "${TARGET_DIR}"

# 6. Ignore the .env file
grep -q ".env" .gitignore 2>/dev/null || echo ".env" >> .gitignore

# 7. Add details to the .env file
echo "TARGET_DIR=${TARGET_DIR}" > .env
echo "BRANCH_NAME=${BRANCH_NAME}" >> .env